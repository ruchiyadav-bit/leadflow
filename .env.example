APP_NAME=LeadFlow
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-jwt-secret-min-32-chars-long

# Database
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=leadflow
DB_USERNAME=leadflow
DB_PASSWORD=leadflow_secret
DB_CHARSET=utf8mb4

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Ping/Post
PING_DEFAULT_TIMEOUT_MS=3000
PING_MAX_CONCURRENCY=25
POST_DEFAULT_TIMEOUT_MS=8000
AUCTION_MIN_BID=0.01
AUCTION_TIE_BREAK=response_time

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=info
LOG_PATH=storage/logs/app.log

# Security
RATE_LIMIT_PER_MINUTE=600
SESSION_LIFETIME_MIN=120
BCRYPT_COST=12

# TrustedForm / Jornaya (optional server-side verification)
TRUSTEDFORM_API_KEY=
JORNAYA_API_KEY=
